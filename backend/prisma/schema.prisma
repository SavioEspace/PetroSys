generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusContrato {
  ATIVO
  SUSPENSO
  ENCERRADO
}

enum StatusServico {
  ATIVO
  SUSPENSO
  ENCERRADO
}

enum PrioridadeOrdemServico {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum StatusOrdemServico {
  ABERTA
  EM_ANDAMENTO
  BLOQUEADA
  CONCLUIDA
  CANCELADA
}

model Perfil {
  id        Int      @id @default(autoincrement())
  nome      String   @unique @db.VarChar(30)
  descricao String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  usuarios Usuario[]

  @@map("perfis")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(255)
  senhaHash String   @map("senha_hash") @db.VarChar(255)
  ativo     Boolean  @default(true)
  perfilId  Int      @map("perfil_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  perfil Perfil @relation(fields: [perfilId], references: [id])

  ordensResponsavel OrdemServico[]    @relation("ResponsavelOrdemServico")
  ordensCriadas     OrdemServico[]    @relation("CriadorOrdemServico")
  historicosStatus  HistoricoStatus[]

  @@index([perfilId])
  @@map("usuarios")
}

model Cliente {
  id           Int      @id @default(autoincrement())
  razaoSocial  String   @map("razao_social") @db.VarChar(200)
  nomeFantasia String?  @map("nome_fantasia") @db.VarChar(200)
  cnpj         String   @unique @db.Char(14)
  email        String?  @db.VarChar(255)
  telefone     String?  @db.VarChar(20)
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  contratos Contrato[]

  @@index([razaoSocial])
  @@index([ativo])
  @@map("clientes")
}

model Contrato {
  id          Int            @id @default(autoincrement())
  numero      String         @unique @db.VarChar(50)
  objeto      String         @db.Text
  dataInicio  DateTime       @map("data_inicio") @db.Date
  dataFim     DateTime       @map("data_fim") @db.Date
  status      StatusContrato @default(ATIVO)
  observacoes String?        @db.Text
  clienteId   Int            @map("cliente_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  cliente       Cliente              @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  servicos      ServicoTecnologico[]
  ordensServico OrdemServico[]

  @@index([clienteId])
  @@index([status])
  @@index([dataFim])
  @@map("contratos")
}

model ServicoTecnologico {
  id         Int           @id @default(autoincrement())
  nome       String        @db.VarChar(150)
  descricao  String        @db.Text
  categoria  String        @db.VarChar(100)
  status     StatusServico @default(ATIVO)
  contratoId Int           @map("contrato_id")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  contrato      Contrato       @relation(fields: [contratoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ordensServico OrdemServico[]

  @@unique([contratoId, nome])
  @@index([contratoId])
  @@index([status])
  @@index([categoria])
  @@map("servicos_tecnologicos")
}

model OrdemServico {
  id            Int                    @id @default(autoincrement())
  codigo        String                 @unique @db.VarChar(20)
  titulo        String                 @db.VarChar(200)
  descricao     String                 @db.Text
  prioridade    PrioridadeOrdemServico @default(MEDIA)
  status        StatusOrdemServico     @default(ABERTA)
  dataAbertura  DateTime               @default(now()) @map("data_abertura")
  prazo         DateTime               @db.Date
  dataConclusao DateTime?              @map("data_conclusao")
  contratoId    Int                    @map("contrato_id")
  servicoId     Int                    @map("servico_id")
  responsavelId Int                    @map("responsavel_id")
  criadoPorId   Int                    @map("criado_por_id")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  contrato    Contrato           @relation(fields: [contratoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  servico     ServicoTecnologico @relation(fields: [servicoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsavel Usuario            @relation("ResponsavelOrdemServico", fields: [responsavelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  criadoPor   Usuario            @relation("CriadorOrdemServico", fields: [criadoPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  historicos HistoricoStatus[]

  @@index([contratoId])
  @@index([servicoId])
  @@index([responsavelId])
  @@index([criadoPorId])
  @@index([status])
  @@index([prioridade])
  @@index([prazo])
  @@map("ordens_servico")
}

model HistoricoStatus {
  id             Int                 @id @default(autoincrement())
  ordemServicoId Int                 @map("ordem_servico_id")
  usuarioId      Int                 @map("usuario_id")
  statusAnterior StatusOrdemServico? @map("status_anterior")
  statusNovo     StatusOrdemServico  @map("status_novo")
  observacao     String?             @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ordemServicoId])
  @@index([usuarioId])
  @@index([createdAt])
  @@map("historicos_status")
}
